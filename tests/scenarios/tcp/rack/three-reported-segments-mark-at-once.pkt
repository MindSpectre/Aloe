+0 write(4, ..., 100) = 100
+0 > P. 201:301(100) ack 1 win 46336 <nop,nop,TS val 10 ecr 110>
+0 write(4, ..., 100) = 100
+0 > P. 301:401(100) ack 1 win 46336 <nop,nop,TS val 10 ecr 110>
+0.010 < . 1:1(0) ack 1 win 512 <nop,nop,TS val 120 ecr 10,nop,nop,sack 101:401>
+0 > P. 1:101(100) ack 1 win 46336 <nop,nop,TS val 20 ecr 120>
