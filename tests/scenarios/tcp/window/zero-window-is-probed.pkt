// The peer's window closes with nothing in flight: a probe, a pure ACK at snd_una - 1, after one RTO, then at
// doubling intervals. Aloe probes whether or not the application has data, where Linux probes only while it
// holds unsent data; see the TCP page.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 < . 1:1(0) ack 1 win 0 <nop,nop,TS val 100 ecr 0>
+0.2 > . 0:0(0) ack 1 win 46720 <nop,nop,TS val 200 ecr 100>
+0.4 > . 0:0(0) ack 1 win 46720 <nop,nop,TS val 600 ecr 100>
+0.8 > . 0:0(0) ack 1 win 46720 <nop,nop,TS val 1400 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 1400>
+0 write(4, ..., 10) = 10
+0 > P. 1:11(10) ack 1 win 46720 <nop,nop,TS val 1400 ecr 100>
+0 < . 1:1(0) ack 11 win 65535 <nop,nop,TS val 100 ecr 1400>
