// The stack's window is zero when the peer's 100 bytes at RCV.NXT arrive, acknowledging the stack's 1000: the segment
// has no room, so its ACK is read and its payload refused, answered at once with the edge restated. With four slots and
// timestamps the budget is 4 * 1448 / 2 = 2896 and the edge stands at 1 + 2896 = 2897, so two full segments close the
// window, each ACK stating 2897 less its acknowledgement. The 1000 bytes are never sent again: the write 300 ms later,
// past the RTO of 200 ms the handshake's zero round trip leaves, goes out as the next segment, and the read finds the
// 2896 bytes and not the 100. That read empties every slot: 2897 + 2896 is 2896 past the edge and the window on offer is
// zero, so the update states 2896. Linux at this commit drops such a segment whole, its ACK with it, unless its receive
// queue is empty (tcp_sequence), which here it is not, and answers it at once with a duplicate ACK, since its limiter
// spares a data segment without a SYN (tcp_oow_rate_limited); RFC 9293 3.10.7.4 asks for the ACK to be read.
--tcp_receive_segments=4
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 2896 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 < P. 1:1449(1448) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 1449 win 1448 <nop,nop,TS val 0 ecr 100>
+0 < P. 1449:2897(1448) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 2897 win 0 <nop,nop,TS val 0 ecr 100>
+0 write(4, ..., 1000) = 1000
+0 > P. 1:1001(1000) ack 2897 win 0 <nop,nop,TS val 0 ecr 100>

+0.01 < P. 2897:2997(100) ack 1001 win 65535 <nop,nop,TS val 110 ecr 0>
+0 > . 1001:1001(0) ack 2897 win 0 <nop,nop,TS val 10 ecr 110>

+0.3 write(4, ..., 10) = 10
+0 > P. 1001:1011(10) ack 2897 win 0 <nop,nop,TS val 310 ecr 110>
+0 < . 2897:2897(0) ack 1011 win 65535 <nop,nop,TS val 120 ecr 310>
+0 read(4, ..., 4000) = 2896
+0 > . 1011:1011(0) ack 2897 win 2896 <nop,nop,TS val 310 ecr 120>
