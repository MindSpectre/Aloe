// A send cap of two segments: the third byte waits for the first ACK, and write reports what was accepted.
--tcp_send_segments=2
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460>
+0 < . 1:1(0) ack 1 win 65535
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 3000) = 2000
+0 > P. 1:1001(1000) ack 1 win 46720
+0 > P. 1001:2001(1000) ack 1 win 46720
+0 < . 1:1(0) ack 1001 win 65535
+0 write(4, ..., 1000) = 1000
+0 > P. 2001:3001(1000) ack 1 win 46720
+0 < . 1:1(0) ack 3001 win 65535
