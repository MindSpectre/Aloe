// RFC 6582's guard: two segments, the first resent by the timeout at +0.2, which records recover = 1976, the last byte
// sent. Three duplicates then acknowledge 1, which does not cover more than recover, so they start no fast retransmit
// and nothing goes out. The ACK of the head is short of recover: the loss episode the timeout began resends the next
// head at once; the ACK of both ends it. Linux stays in its loss state until the same ACK and resends the second
// segment on the first ACK as well.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 1976) = 1976
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0.2 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 200 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 200>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 200>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 200>
+0 < . 1:1(0) ack 989 win 65535 <nop,nop,TS val 100 ecr 200>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 200 ecr 100>
+0 < . 1:1(0) ack 1977 win 65535 <nop,nop,TS val 100 ecr 200>
+2 close(4) = 0
+0 > F. 1977:1977(0) ack 1 win 65535 <nop,nop,TS val 2200 ecr 100>
+0 < . 1:1(0) ack 1978 win 65535 <nop,nop,TS val 100 ecr 2200>
