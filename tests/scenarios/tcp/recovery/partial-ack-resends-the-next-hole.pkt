// A partial ACK in recovery: five segments of 988, the first two lost. Three duplicates mark the head lost, recovery
// begins and the head is resent. The ACK of the head alone does not cover recover, the last byte sent when recovery
// began, so it is RFC 6582's partial ACK: it marks the new head lost, and that goes again at once rather than after
// three more duplicates or the timer. The ACK of all five ends recovery. The lines are the same under both policies.
// Under NewReno the window is PRR's: at the third duplicate 2964 of the 4940 outstanding are counted received and 988
// lost, 988 in flight, below the target max(4940 / 2, 2 * 988) = 2470, so the conservative bound allows the 988 the
// ACK delivered and the head leaves on a window of 1976. The partial ACK delivers one segment more, the hole it
// filled; of the 3952 outstanding, 2964 are counted received and 988 lost, nothing in flight, and the bound allows
// 988: the next hole. Without congestion control nothing bounds a resend. Linux marks and resends the same segment on
// a partial ACK (tcp_newreno_mark_lost), under PRR in whole segments.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 4940) = 4940
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 2965:3953(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 3953:4941(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 989 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 4941 win 65535 <nop,nop,TS val 100 ecr 0>
+2 close(4) = 0
+0 > F. 4941:4941(0) ack 1 win 65535 <nop,nop,TS val 2000 ecr 100>
+0 < . 1:1(0) ack 4942 win 65535 <nop,nop,TS val 100 ecr 2000>
