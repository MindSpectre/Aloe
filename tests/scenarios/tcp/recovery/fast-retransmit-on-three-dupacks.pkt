// Ten segments of 988 in flight, 9880, the first lost: three duplicate ACKs resend it at once, before any timer. The
// peer has no SACK, so each duplicate stands for one segment it holds: at the third, 2964 are counted received and the
// head, marked lost, is 988 more out of what is in flight, 9880 - 2964 - 988 = 5928. Recovery begins with the target
// max(9880 / 2, 2 * 988) = 4940 and RecoverFS 9880, and PRR's first step allows ceil(988 * 4940 / 9880) = 494 above
// what is in flight, a window of 6422, so the head leaves. The ACK of everything ends recovery. Linux resends at the
// same duplicate and runs PRR too, in whole segments and dividing by the window it had where RFC 9937 divides by
// RecoverFS; neither window shows here.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 9880) = 9880
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 2965:3953(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 3953:4941(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 4941:5929(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 5929:6917(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 6917:7905(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 7905:8893(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 8893:9881(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 9881 win 65535 <nop,nop,TS val 100 ecr 0>
+2 close(4) = 0
+0 > F. 9881:9881(0) ack 1 win 65535 <nop,nop,TS val 2000 ecr 100>
+0 < . 1:1(0) ack 9882 win 65535 <nop,nop,TS val 100 ecr 2000>
