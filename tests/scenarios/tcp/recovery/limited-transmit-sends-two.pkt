// RFC 3042's limited transmit, which comes from what is in flight: ten segments of 988 bytes (the peer's MSS of 1000
// less the timestamp option) fill NewReno's initial window of 9880, so a write of 12000 sends 9880. Each of the first
// two duplicate ACKs stands for a segment the peer holds, takes 988 out of what is in flight and so lets one segment
// out, all a write can send then. The third marks the head lost: of the 11856 outstanding, 2964 are counted received
// and 988 lost, 7904 in flight. The target leaves out the two segments sent beyond the window (RFC 5681 3.2):
// max(9880 / 2, 2 * 988) = 4940. RecoverFS is the whole flight, 11856, and PRR allows
// ceil(988 * 4940 / 11856) = 412 above what is in flight, so the head is resent at once. Linux lets the same two
// out, since each duplicate takes a segment out of its count in flight, with no allowance of its own either
// (tcp_cwnd_test), and resends the head at the third; its reno halves the window too, and its PRR counts whole
// segments and divides by the window it had.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 12000) = 9880
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 2965:3953(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 3953:4941(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 4941:5929(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 5929:6917(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 6917:7905(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 7905:8893(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 8893:9881(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 write(4, ..., 2120) = 988
+0 > P. 9881:10869(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 write(4, ..., 1132) = 988
+0 > P. 10869:11857(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 11857 win 65535 <nop,nop,TS val 100 ecr 0>
+2 close(4) = 0
+0 > F. 11857:11857(0) ack 1 win 65535 <nop,nop,TS val 2000 ecr 100>
+0 < . 1:1(0) ack 11858 win 65535 <nop,nop,TS val 100 ecr 2000>
