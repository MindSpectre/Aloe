// RFC 3042's limited transmit: ten segments fill NewReno's initial window, ten segments of 988 bytes (the peer's MSS of
// 1000 less the timestamp option), so a write of 12000 sends 9880. The first and the second duplicate ACK each let one
// more segment out beyond the window, all a write can send then; the third resends the head at once. Linux lets the
// same two out, since each duplicate takes a segment out of its count in flight, and then runs PRR in recovery, which
// does not show here.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 12000) = 9880
+0 > P. 1:989(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 2965:3953(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 3953:4941(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 4941:5929(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 5929:6917(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 6917:7905(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 7905:8893(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 8893:9881(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 write(4, ..., 2120) = 988
+0 > P. 9881:10869(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 write(4, ..., 1132) = 988
+0 > P. 10869:11857(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > P. 1:989(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 11857 win 65535 <nop,nop,TS val 100 ecr 0>
+2 close(4) = 0
+0 > F. 11857:11857(0) ack 1 win 46720 <nop,nop,TS val 2000 ecr 100>
+0 < . 1:1(0) ack 11858 win 65535 <nop,nop,TS val 100 ecr 2000>
