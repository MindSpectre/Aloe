// The script of karn-skips-a-retransmitted-sample with timestamps on: the ACK of the resent first segment echoes
// the resend's value, in the resend's own millisecond. That is a sample of one tick, 1 ms, where the clock shows none
// (a zero delta counts as one tick, as Linux's tcp_rtt_tsopt_us counts it), and where Karn's rule gives none, so the
// backoff ends: RTO 200.125 ms (srtt 0.125, rttvar 0.25: 0.125 + max(1, 200)), and the second write's resend comes at
// the first tick from 200.125 ms on, +0.201 and value 401, not +0.4. Its ACK echoes that resend the same way, one tick
// again: srtt 0.234375, rttvar 0.40625. The third write's ACK, 50 ms after it left, samples from the sequence as
// before: RTO 206.455078 ms (srtt 6.455078, rttvar 12.746093: 6.455078 + max(50.984372, 200)), so the fourth write's
// resend comes at the first tick from 206.455078 ms on, +0.207, its value 658.
// Linux falls back to the echo the same way (tcp_ack_update_rtt).
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 10) = 10
+0 > P. 1:11(10) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0.2 > P. 1:11(10) ack 1 win 65535 <nop,nop,TS val 200 ecr 100>
+0 < . 1:1(0) ack 11 win 65535 <nop,nop,TS val 100 ecr 200>
+0 write(4, ..., 10) = 10
+0 > P. 11:21(10) ack 1 win 65535 <nop,nop,TS val 200 ecr 100>
+0.201 > P. 11:21(10) ack 1 win 65535 <nop,nop,TS val 401 ecr 100>
+0 < . 1:1(0) ack 21 win 65535 <nop,nop,TS val 100 ecr 401>
+0 write(4, ..., 10) = 10
+0 > P. 21:31(10) ack 1 win 65535 <nop,nop,TS val 401 ecr 100>
+0.05 < . 1:1(0) ack 31 win 65535 <nop,nop,TS val 100 ecr 401>
+0 write(4, ..., 10) = 10
+0 > P. 31:41(10) ack 1 win 65535 <nop,nop,TS val 451 ecr 100>
+0.207 > P. 31:41(10) ack 1 win 65535 <nop,nop,TS val 658 ecr 100>
+0 < . 1:1(0) ack 41 win 65535 <nop,nop,TS val 100 ecr 658>
