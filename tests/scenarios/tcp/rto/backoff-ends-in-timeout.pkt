// Three data retries then TimedOut: resends at +0.2, +0.4 (after the previous) and +0.8, each with the clock's value
// then, and the fourth expiry, 1.6 s after the third resend, ends the connection; read reports ETIMEDOUT then.
// Linux's default is 15 retries.
--tcp_data_retries=3
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 10) = 10
+0 > P. 1:11(10) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0.2 > P. 1:11(10) ack 1 win 46720 <nop,nop,TS val 200 ecr 100>
+0.4 > P. 1:11(10) ack 1 win 46720 <nop,nop,TS val 600 ecr 100>
+0.8 > P. 1:11(10) ack 1 win 46720 <nop,nop,TS val 1400 ecr 100>
+1.6~+1.61 read(4, ..., 1) = -1 ETIMEDOUT
