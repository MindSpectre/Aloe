// The peer does not acknowledge our FIN: after a handshake with a zero round trip the RTO is rto_min, 200 ms,
// so the FIN goes again at +0.2 and +0.4 (doubling), then the peer's ACK arrives and the connection waits in
// FIN-WAIT-2, sending nothing. Linux would retry on its own RTO, also from a 200 ms floor.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 close(4) = 0
+0 > F. 1:1(0) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0.2 > F. 1:1(0) ack 1 win 65535 <nop,nop,TS val 200 ecr 100>
+0.4 > F. 1:1(0) ack 1 win 65535 <nop,nop,TS val 600 ecr 100>
+0 < . 1:1(0) ack 2 win 65535 <nop,nop,TS val 100 ecr 600>

// Five quiet seconds: a FIN whose timer was not cancelled would go again at +0.8.
+5 close(3) = 0
