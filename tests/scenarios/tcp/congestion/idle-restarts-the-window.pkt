// RFC 5681's restart after idle: ten segments acknowledged one by one double the window to twenty segments, but the
// next write comes 300 ms later, past the RTO of 200 ms with nothing in flight, so the window restarts at
// min(IW, cwnd), the initial ten, and the write sends 9880. Linux halves its window per RTO of idle down to the initial
// window (tcp_cwnd_restart), which after 300 ms is also ten.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 9880) = 9880
+0 > P. 1:989(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 2965:3953(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 3953:4941(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 4941:5929(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 5929:6917(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 6917:7905(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 7905:8893(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 8893:9881(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 989 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 1977 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 2965 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 3953 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 4941 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 5929 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 6917 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 7905 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 8893 win 65535 <nop,nop,TS val 100 ecr 0>
+0 < . 1:1(0) ack 9881 win 65535 <nop,nop,TS val 100 ecr 0>
+0.3 write(4, ..., 20000) = 9880
+0 > P. 9881:10869(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 10869:11857(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 11857:12845(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 12845:13833(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 13833:14821(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 14821:15809(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 15809:16797(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 16797:17785(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 17785:18773(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 > P. 18773:19761(988) ack 1 win 46720 <nop,nop,TS val 300 ecr 100>
+0 < . 1:1(0) ack 19761 win 65535 <nop,nop,TS val 100 ecr 300>
