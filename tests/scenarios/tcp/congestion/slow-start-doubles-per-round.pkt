// Slow start: ten segments, acknowledged one by one; each ACK grows the window by the segment it acknowledges, so the
// window doubles to twenty segments, 19760 bytes, in one round and the next write sends twenty. Linux's slow start
// grows the same way, a segment per segment acknowledged.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 9880) = 9880
