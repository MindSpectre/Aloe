// Without congestion control the peer's window is the only limit: a write of forty segments, four times NewReno's
// initial window, leaves at once, with the send cap raised to 64 entries to hold them. Linux has no such policy; it
// would start at ten segments.
--congestion=none
--tcp_send_segments=64
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 39520) = 39520
