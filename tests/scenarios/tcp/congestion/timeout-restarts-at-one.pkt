// A timeout restarts the window at one segment: three segments, all lost, the head resent at +0.2. Each ACK of new data
// short of recover resends the next head and nothing more, while the window grows from one segment to the threshold,
// max(2964 / 2, 2 * 988) = 1976, by slow start and then by a segment once a window of 1976 is acknowledged: the write
// after the episode sends three. Linux marks all three lost at the timeout and resends as its window allows, two after
// the first ACK; here each ACK resends one, until RACK.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 2964) = 2964
+0 > P. 1:989(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0.2 > P. 1:989(988) ack 1 win 46720 <nop,nop,TS val 200 ecr 100>
+0 < . 1:1(0) ack 989 win 65535 <nop,nop,TS val 100 ecr 200>
+0 > P. 989:1977(988) ack 1 win 46720 <nop,nop,TS val 200 ecr 100>
+0 < . 1:1(0) ack 1977 win 65535 <nop,nop,TS val 100 ecr 200>
+0 > P. 1977:2965(988) ack 1 win 46720 <nop,nop,TS val 200 ecr 100>
+0 < . 1:1(0) ack 2965 win 65535 <nop,nop,TS val 100 ecr 200>
+0 write(4, ..., 9880) = 2964
+0 > P. 2965:3953(988) ack 1 win 46720 <nop,nop,TS val 200 ecr 100>
+0 > P. 3953:4941(988) ack 1 win 46720 <nop,nop,TS val 200 ecr 100>
+0 > P. 4941:5929(988) ack 1 win 46720 <nop,nop,TS val 200 ecr 100>
+0 < . 1:1(0) ack 5929 win 65535 <nop,nop,TS val 100 ecr 200>
+2 close(4) = 0
+0 > F. 5929:5929(0) ack 1 win 46720 <nop,nop,TS val 2200 ecr 100>
+0 < . 1:1(0) ack 5930 win 65535 <nop,nop,TS val 100 ecr 2200>
