// A timeout restarts the window at one segment: three segments of 988, all lost. The expiry at +0.2 marks all three
// lost, sets the target max(2964 / 2, 2 * 988) = 1976, and restarts the window at what is in flight after the
// marking, nothing, plus one segment: the head goes again alone. Its ACK, a tenth of a second later so that an
// earlier resend would fail the line, grows the window by slow start to 1976, since 988 is below twice the 2964 the
// write left in flight, and the two entries still marked fill it. The window is at the target now, and congestion
// avoidance grows only a window that limited a send of new data: the write left 2964 in flight under a window of
// 9880, and a resend is not such a send, as Linux's resends never reach tcp_cwnd_validate. So the next two ACKs, the
// second of which ends the loss state, grow nothing, and the write after them accepts two segments, which fill the
// window. Linux marks all three at the timeout too and resends two after the first ACK (tcp_enter_loss,
// tcp_xmit_retransmit_queue), but its target is half its window, five segments (tcp_reno_ssthresh), so it is still
// in slow start, where a window below twice the most in flight, three segments, grows on every ACK
// (tcp_is_cwnd_limited), the last one included.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 2964) = 2964
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0.2 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 200 ecr 100>
+0.1 < . 1:1(0) ack 989 win 65535 <nop,nop,TS val 100 ecr 200>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 300 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 65535 <nop,nop,TS val 300 ecr 100>
+0 < . 1:1(0) ack 1977 win 65535 <nop,nop,TS val 100 ecr 300>
+0 < . 1:1(0) ack 2965 win 65535 <nop,nop,TS val 100 ecr 300>
+0 write(4, ..., 9880) = 1976
+0 > P. 2965:3953(988) ack 1 win 65535 <nop,nop,TS val 300 ecr 100>
+0 > P. 3953:4941(988) ack 1 win 65535 <nop,nop,TS val 300 ecr 100>
+0 < . 1:1(0) ack 4941 win 65535 <nop,nop,TS val 100 ecr 300>
+2 close(4) = 0
+0 > F. 4941:4941(0) ack 1 win 65535 <nop,nop,TS val 2300 ecr 100>
+0 < . 1:1(0) ack 4942 win 65535 <nop,nop,TS val 100 ecr 2300>
