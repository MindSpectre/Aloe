// A segment above a gap that covers a held one from its first byte replaces it: the held packet is released and
// the newcomer is kept whole. Each is answered at once with a duplicate ACK that restates the window; the segment
// that fills the gap delivers 2000 bytes, acknowledged at once. The numbers: the edge stands at 1 + 65535 = 65536,
// so a restated window at RCV.NXT 1 is 65535 and the ACK at 2001 states 65536 - 2001 = 63535. This peer offered
// no SACK, so no duplicate block reports the replaced range. Linux does the same (tcp_data_queue_ofo).
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 < P. 1001:1501(500) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < P. 1001:2001(1000) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < P. 1:1001(1000) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 2001 win 63535 <nop,nop,TS val 0 ecr 100>
+0 read(4, ..., 3000) = 2000
