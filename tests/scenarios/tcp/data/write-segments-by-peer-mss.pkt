// The peer's SYN carries an MSS of 1000: a write of 2500 leaves as three segments of 988, 988 and 524, the MSS
// less the 12 bytes of the timestamp option, all at once; the peer acknowledges them one by one, which the runner's
// queue model allows between the lines.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 2500) = 2500
+0 > P. 1:989(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 989 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > P. 989:1977(988) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1977 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > P. 1977:2501(524) ack 1 win 46720 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 2501 win 65535 <nop,nop,TS val 100 ecr 0>
