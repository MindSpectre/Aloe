// In-order data is acknowledged at the flush, with the window less the unread bytes. A read sends a window update of
// its own only when the window it frees at least doubles the one on offer, at the next flush: four slots give a
// budget of 4 * 1448 / 2 = 2896 bytes, so the first read of 1000 sends nothing and the second, which takes the window
// from 896 to 2896, sends one. Linux would delay the first ACK up to 40 ms; its update follows the same doubling rule.
--tcp_receive_segments=4
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 2896 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 < P. 1:1001(1000) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 1001 win 1896 <nop,nop,TS val 0 ecr 100>
+0 read(4, ..., 1000) = 1000
+0 < P. 1001:2001(1000) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 2001 win 896 <nop,nop,TS val 0 ecr 100>
+0 read(4, ..., 1000) = 1000
+0 > . 1:1(0) ack 2001 win 2896 <nop,nop,TS val 0 ecr 100>
