// A peer that uses SACK puts blocks on its duplicate ACKs. The stack's sender does not read them yet: it skips the
// option and counts each ACK as a duplicate all the same, so three of them resend the lost first segment at once, as
// without SACK. The peer offers SACK and no window scaling, so the SYN-ACK echoes `sackOK` beside the timestamps and
// every window is 65535 bytes, unscaled. Ten segments of 1000 - 12 = 988 bytes are in flight; the blocks report the
// second segment onward, relative to the stack's ISN. Linux reads the blocks and marks what they cover (RFC 6675,
// RACK); its first resend is the same here, and its recovery arithmetic (PRR) does not show.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,sackOK,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 9880) = 9880
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 1977:2965(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 2965:3953(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 3953:4941(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 4941:5929(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 5929:6917(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 6917:7905(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 7905:8893(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 > P. 8893:9881(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0,nop,nop,sack 989:1977>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0,nop,nop,sack 989:2965>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0,nop,nop,sack 989:3953>
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 9881 win 65535 <nop,nop,TS val 100 ecr 0>
