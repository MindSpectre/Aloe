// An in-order segment whose first 500 bytes are old: the new part is taken and the old prefix is reported as a
// duplicate SACK on the ordinary ACK at the flush, not at once. That ACK states the window from RCV.NXT 1501 with 1500
// unread: the candidate, 1501 + 370688 - 1500 = 370689, is the edge, and (370689 - 1501) / 8 rounds up to 46149. The
// read does not double the window, so no update follows. Linux reports the prefix the same way (tcp_data_queue) and
// sends its ACK on its delayed-ACK schedule.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,TS val 0 ecr 100,nop,wscale 3>
+0 < . 1:1(0) ack 1 win 512 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 < P. 1:1001(1000) ack 1 win 512 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 1001 win 46211 <nop,nop,TS val 0 ecr 100>
+0 < P. 501:1501(1000) ack 1 win 512 <nop,nop,TS val 100 ecr 0>
+0 > . 1:1(0) ack 1501 win 46149 <nop,nop,TS val 0 ecr 100,nop,nop,sack 501:1001>
+0 read(4, ..., 2000) = 1500
