// A peer that uses SACK puts blocks on its ACKs, and the stack reads them: what they report comes out of what is in
// flight, and RACK judges the segments sent before them (RFC 8985), where three duplicates once did. The peer offers
// SACK and no window scaling, so the SYN-ACK echoes `sackOK` beside the timestamps and every window is 65535 bytes,
// unscaled; a segment carries 1000 - 12 = 988 bytes and the initial window is ten of them, 9880. The handshake's ACK
// 10 ms after the SYN-ACK gives a round trip of 10 ms. Ten segments leave at 10 ms; the blocks, 10 ms later, report the
// second segment onward, relative to the stack's ISN. The first takes 988 out of what is in flight, 8892, so a write
// of one more segment leaves (RFC 3042's limited transmit, as Linux's tcp_cwnd_test gives it); RACK's round trip is
// 10 ms and its window 10 / 4 = 2.5 ms with one segment reported, so the head waits. The second does the same. The
// third makes three segments reported: the window is zero, and the head, due at 10 + 10 + 0 = 20 ms, is lost now. Of
// 11856 outstanding, 2964 are reported and 988 lost, 7904 in flight; the target is max(9880 / 2, 2 * 988) = 4940,
// since what limited transmit sent beyond the window is left out of the flight it halves (RFC 5681 3.2), RecoverFS is
// 11856 - 2964 + 988 = 9880, and PRR allows ceil(988 * 4940 / 9880) = 494 above what is in flight, so the head leaves.
// Linux reads the blocks too and marks by RACK; its window is zero at the third report as well, so its first resend
// is the same here, and its PRR does not show.
--congestion=newreno
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1000,sackOK,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,TS val 0 ecr 100>
+0.010 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 110 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 9880) = 9880
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 989:1977(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 1977:2965(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 2965:3953(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 3953:4941(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 4941:5929(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 5929:6917(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 6917:7905(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 7905:8893(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0 > P. 8893:9881(988) ack 1 win 65535 <nop,nop,TS val 10 ecr 110>
+0.010 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 120 ecr 10,nop,nop,sack 989:1977>
+0 write(4, ..., 988) = 988
+0 > P. 9881:10869(988) ack 1 win 65535 <nop,nop,TS val 20 ecr 120>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 120 ecr 10,nop,nop,sack 989:2965>
+0 write(4, ..., 988) = 988
+0 > P. 10869:11857(988) ack 1 win 65535 <nop,nop,TS val 20 ecr 120>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 120 ecr 10,nop,nop,sack 989:3953>
+0 > P. 1:989(988) ack 1 win 65535 <nop,nop,TS val 20 ecr 120>
+0.010 < . 1:1(0) ack 11857 win 65535 <nop,nop,TS val 130 ecr 20>
