// --tcp_tail_probe_ack_delay_ms=0: a deployment whose peer answers at once takes no allowance, and a lone segment is
// probed two smoothed round trips after it left, as a burst's tail is. The handshake's ACK 10 ms after the SYN-ACK
// gives an srtt of 10 ms; the write at 10 ms is probed at 10 + 2 * 10 + 0 = 30 ms, TS val 30. Linux has no such
// setting: its allowance for a lone segment is its minimum RTO, 200 ms unless a route lowers it (tcp_rto_min_us).
--tcp_tail_probe_ack_delay_ms=0
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,TS val 0 ecr 100,nop,wscale 3>
+0.010 < . 1:1(0) ack 1 win 512 <nop,nop,TS val 110 ecr 0>
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 100) = 100
+0 > P. 1:101(100) ack 1 win 46336 <nop,nop,TS val 10 ecr 110>
+0.020 > P. 1:101(100) ack 1 win 46336 <nop,nop,TS val 30 ecr 110>
+0 < . 1:1(0) ack 101 win 512 <nop,nop,TS val 130 ecr 30>
