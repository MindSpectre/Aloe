// The peer's ACK is late: our SYN-ACK goes again after 1, 2 and 4 seconds, each with the clock's value then, and
// the ACK, echoing the last one, completes the handshake.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+1 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 1000 ecr 100>
+2 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 3000 ecr 100>
+4 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 7000 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 7000>
+0 accept(3, ..., ...) = 4
