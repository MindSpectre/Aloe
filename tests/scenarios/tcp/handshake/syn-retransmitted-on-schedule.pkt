// No answer to our SYN: it goes again 1, 3, 7, 15 and 31 seconds after the first, each with the clock's value then,
// and the connection times out at 63 seconds. Linux retries six times with the same doubling and gives up at 127
// seconds.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 fcntl(3, F_SETFL, O_RDWR|O_NONBLOCK) = 0
+0 connect(3, ..., ...) = -1 EINPROGRESS (Operation now in progress)
+0 > S 0:0(0) win 65535 <mss 1460,sackOK,TS val 0 ecr 0,nop,wscale 3>
+1 > S 0:0(0) win 65535 <mss 1460,sackOK,TS val 1000 ecr 0,nop,wscale 3>
+2 > S 0:0(0) win 65535 <mss 1460,sackOK,TS val 3000 ecr 0,nop,wscale 3>
+4 > S 0:0(0) win 65535 <mss 1460,sackOK,TS val 7000 ecr 0,nop,wscale 3>
+8 > S 0:0(0) win 65535 <mss 1460,sackOK,TS val 15000 ecr 0,nop,wscale 3>
+16 > S 0:0(0) win 65535 <mss 1460,sackOK,TS val 31000 ecr 0,nop,wscale 3>
+32~+32.01 read(3, ..., 1) = -1 ETIMEDOUT
