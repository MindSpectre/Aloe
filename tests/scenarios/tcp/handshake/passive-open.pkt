// A passive open: the peer's SYN, our SYN-ACK with the two options Aloe sends, the MSS and the timestamps, the
// peer's ACK, accept. The SYN-ACK offers 65535: half of 512 slots of 1448 bytes, capped at the unscaled field;
// Linux would add sackOK and wscale.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4
+0 close(3) = 0
