// A segment without the timestamp option on a connection that negotiated it is taken, acknowledged and read, as
// Linux takes it; RFC 7323 would rather it were dropped. The ACK still echoes the peer's last value.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 100 ecr 0>
+0 > S. 0:0(0) ack 1 win 46720 <mss 1460,nop,nop,TS val 0 ecr 100>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 100 ecr 0>
+0 accept(3, ..., ...) = 4

+0 < P. 1:11(10) ack 1 win 65535
+0 > . 1:1(0) ack 11 win 46710 <nop,nop,TS val 0 ecr 100>
+0 read(4, ..., 100) = 10
+0 > . 1:1(0) ack 11 win 46720 <nop,nop,TS val 0 ecr 100>
