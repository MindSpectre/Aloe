// PAWS: a segment whose timestamp is older than the last one accepted is dropped and acknowledged at once, and
// read never sees its bytes; the same bytes with a fresh timestamp are taken. Linux does the same.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460,nop,nop,TS val 500 ecr 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,nop,TS val 0 ecr 500>
+0 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 500 ecr 0>
+0 accept(3, ..., ...) = 4

+0 < P. 1:11(10) ack 1 win 65535 <nop,nop,TS val 500 ecr 0>
+0 > . 1:1(0) ack 11 win 65525 <nop,nop,TS val 0 ecr 500>
+0 < P. 11:21(10) ack 1 win 65535 <nop,nop,TS val 400 ecr 0>
+0 > . 1:1(0) ack 11 win 65525 <nop,nop,TS val 0 ecr 500>
+0 read(4, ..., 100) = 10
+0 < P. 11:21(10) ack 1 win 65535 <nop,nop,TS val 600 ecr 0>
+0 > . 1:1(0) ack 21 win 65515 <nop,nop,TS val 0 ecr 600>
+0 read(4, ..., 100) = 10
