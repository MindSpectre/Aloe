// A peer that offers no timestamps: the SYN-ACK answers with the MSS alone, and no segment of the connection carries
// the option, so a segment holds the whole MSS. Linux does the same.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

+0 < S 0:0(0) win 65535 <mss 1460>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460>
+0 < . 1:1(0) ack 1 win 65535
+0 accept(3, ..., ...) = 4

+0 write(4, ..., 10) = 10
+0 > P. 1:11(10) ack 1 win 65535
+0 < . 1:1(0) ack 11 win 65535
