#pragma once

/**
 * Public umbrella for the Aloe core module: the version, the clock aliases and
 * small header-only helpers, with no dependencies, so every module can link it.
 * Consumers link Aloe::Common::Core and write `#include <aloe/core>`.
 */

// Every standard and system header the module's interface units include, textually before the import: clang 22
// rejects libstdc++'s locale redeclarations included after an import (ledger 07).
#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <limits>
#include <ratio>
#include <stdexcept>
#include <string>
#include <string_view>
#include <tuple>
#include <type_traits>
#include <utility>

#if defined(__x86_64__)
    #include <x86intrin.h>
#endif

import aloe.core;
