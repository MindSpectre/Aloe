#!/usr/bin/env bash
#
# Refuses a commit that records a C++ source formatted differently from what .clang-format
# asks, or whose includes break the rules of codestyle.md. cmake/git_hooks.cmake activates it at configure time; by hand:
#
#   git config core.hooksPath .githooks
#
# `git commit --no-verify` skips it. CI runs the same scripts on every pull request.

set -euo pipefail

scripts=$(dirname -- "${BASH_SOURCE[0]}")/../scripts
"$scripts/check-format.sh" --staged
"$scripts/check-includes.sh" --staged
